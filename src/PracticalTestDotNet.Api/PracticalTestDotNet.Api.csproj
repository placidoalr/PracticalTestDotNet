    <ProjectReference Include="..\PracticalTestDotNet.Infrastructure\PracticalTestDotNet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.2" />
